      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * (sum(sum_over_time(temporal_cloud_v1_billable_action_count{temporal_namespace=~\"$namespace\", region=~\"$region\", action_type=~\"$action_type\", temporal_workflow_type=~\"$unattributed_re\"}[$__range])) or vector(0)) / sum(sum_over_time(temporal_cloud_v1_billable_action_count{temporal_namespace=~\"$namespace\", region=~\"$region\", action_type=~\"$action_type\"}[$__range]))",
          "instant": true,
          "range": false
